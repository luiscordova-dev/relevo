{
  // La skill reemplaza NOMBRE-DEL-AGENTE y el id de la base al construirlo.
  "name": "NOMBRE-DEL-AGENTE",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // El cerebro, el oído y la vista. Incluidos en el plan gratis de Cloudflare.
  "ai": { "binding": "AI" },

  // Donde viven tus interesados y las conversaciones.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "NOMBRE-DEL-AGENTE-db",
      "database_id": "ID-DE-LA-BASE"
    }
  ],

  // Cada 15 min revisa recordatorios; a las 3:00 am de México manda el reporte diario.
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    "ZONA_HORARIA": "America/Mexico_City",
    "MODELO_CEREBRO": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "MODELO_OIDO": "@cf/openai/whisper-large-v3-turbo",
    "MODELO_VISTA": "@cf/meta/llama-3.2-11b-vision-instruct",
    // Identifica TU número de WhatsApp. Sin esto el agente NO PUEDE CONTESTAR
    // (y además respondería mensajes de otros números de la misma cuenta).
    // La skill lo saca de `zernio inbox:conversations` y lo pone aquí.
    "ZERNIO_ACCOUNT_ID": "ID-DE-TU-WHATSAPP"
  },

  "observability": { "enabled": true }

  // Secretos (se guardan con `wrangler secret put`, nunca en este archivo):
  //   ZERNIO_API_KEY          — para leer y contestar WhatsApp
  //   ZERNIO_WEBHOOK_SECRET   — para comprobar que los mensajes vienen de Zernio
  //   TELEGRAM_BOT_TOKEN      — tu bot de avisos
  //   TELEGRAM_CHAT_ID        — a quién le avisa (a ti)
  //   CLAVE_PANEL             — la clave de tu panel de interesados
  // Opcionales:
  //   RESEND_API_KEY, CORREO_DUENO   — reporte diario por correo
  //   OPENAI_API_KEY | ANTHROPIC_API_KEY, MODELO_PROPIO — tu propia IA
}
